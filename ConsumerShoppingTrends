CREATE TABLE `consumer_trends` (
  `age` int DEFAULT NULL,
  `monthly_income` int DEFAULT NULL,
  `daily_internet_hours` double DEFAULT NULL,
  `smartphone_usage_years` int DEFAULT NULL,
  `social_media_hours` double DEFAULT NULL,
  `online_payment_trust_score` int DEFAULT NULL,
  `tech_savvy_score` int DEFAULT NULL,
  `monthly_online_orders` int DEFAULT NULL,
  `monthly_store_visits` int DEFAULT NULL,
  `avg_online_spend` int DEFAULT NULL,
  `avg_store_spend` int DEFAULT NULL,
  `discount_sensitivity` int DEFAULT NULL,
  `return_frequency` int DEFAULT NULL,
  `avg_delivery_days` int DEFAULT NULL,
  `delivery_fee_sensitivity` int DEFAULT NULL,
  `free_return_importance` int DEFAULT NULL,
  `product_availability_online` int DEFAULT NULL,
  `impulse_buying_score` int DEFAULT NULL,
  `need_touch_feel_score` int DEFAULT NULL,
  `brand_loyalty_score` int DEFAULT NULL,
  `environmental_awareness` int DEFAULT NULL,
  `time_pressure_level` int DEFAULT NULL,
  `gender` text,
  `city_tier` text,
  `shopping_preference` text
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

#Analysis 

--Analyzing shopping preference

--This query analyzing the shopping preference by age (ages 18-77). 

SELECT age,
       shopping_preference,
       COUNT(shopping_preference) AS count_pref
FROM consumer_trends
GROUP BY age, shopping_preference
ORDER BY age;


--Then, this query analyzing shopping preference betwween age group. This is a common age group used 
in surverys. 

--Age Groups : 
--18-24, 25-34, 35-44, 45-54, 55-64, and 65+. 

--It compares the number of shopping preference each age group prefers; hybrid, online, and store. 

SELECT 
	CASE 
		WHEN age BETWEEN 18 AND 24 THEN '18-24'
        WHEN age BETWEEN 25 AND 34 THEN '25-34'
        WHEN age BETWEEN 35 AND 44 THEN '35-44'
        WHEN age BETWEEN 45 AND 54 THEN '45-54'
        WHEN age BETWEEN 55 AND 64 THEN '55-64'
        ELSE '65+'
	END AS Age_Group,
       shopping_preference,
       COUNT(shopping_preference) AS count_pref
FROM consumer_trends
GROUP BY Age_Group, shopping_preference
ORDER BY Age_Group;



--This query analyzes if tech_savy_score, daily internet hours, and smartphone usuage could be a factor to why each age group would choose their 
shopping preference. 


SELECT 
	CASE 
		WHEN age BETWEEN 18 AND 24 THEN '18-24'
        WHEN age BETWEEN 25 AND 34 THEN '25-34'
        WHEN age BETWEEN 35 AND 44 THEN '35-44'
        WHEN age BETWEEN 45 AND 54 THEN '45-54'
        WHEN age BETWEEN 55 AND 64 THEN '55-64'
        ELSE '65+'
	END AS Age_Group,
    shopping_preference,
       COUNT(shopping_preference) AS count_pref,
ROUND(AVG(tech_savvy_score)) AS Avg_tech_savvy_score,
ROUND(AVG(daily_internet_hours)) AS Avg_internet_hour,
ROUND(AVG(smartphone_usage_years)) AS Avg_Sp_usage_years
FROM consumer_trends
GROUP BY Age_Group,shopping_preference
ORDER BY Age_Group;

--How does daily internet and social media usage vary across different age groups?

SELECT age, 
ROUND(AVG(daily_internet_hours),2)
FROM consumer_trends
GROUP BY age
ORDER BY age; 

SELECT 
	CASE 
		WHEN age BETWEEN 18 AND 24 THEN '18-24'
        WHEN age BETWEEN 25 AND 34 THEN '25-34'
        WHEN age BETWEEN 35 AND 44 THEN '35-44'
        WHEN age BETWEEN 45 AND 54 THEN '45-54'
        WHEN age BETWEEN 55 AND 64 THEN '55-64'
        ELSE '65+'
	END AS Age_Group,
    
		ROUND(AVG(daily_internet_hours),2) AS 'Avg internet hours',
		ROUND(AVG(social_media_hours),2) AS 'Avg Social Media Hours'
	FROM consumer_trends
	GROUP BY Age_Group
	ORDER BY Age_Group
 ;




