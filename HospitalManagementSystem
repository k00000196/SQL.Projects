#This is a hospital management system dataset that consist of patient appointments, staff, and doctors. 
--This dataset was found from Kaggle. 

CREATE TABLE `patient_appointments` (
  `appointment_ID` int DEFAULT NULL,
  `patient_Id` int DEFAULT NULL,
  `doct_Id` int DEFAULT NULL,
  `reason` text,
  `appointment_Date` date DEFAULT NULL,
  `payment_amount` int DEFAULT NULL,
  `mode_of_payment` text,
  `mode_of_appointment` text,
  `appointment_status` text
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci


#Data Cleaning 
--I used the str-to-date function to help clean up date and correctly format the data to Date settings.

SELECT 
  appointment_Date,
  STR_TO_DATE(appointment_Date, '%m/%d/%Y') AS appointment_date
FROM patient_appointments;

--Then, I altered the table to correct the format for appointment_Date from text to Date format.

ALTER TABLE patient_appointments
MODIFY appointment_Date DATE; 


#Analysis

1. How many patients are assigned to each doctor? 

SELECT doct_Id,
COUNT(patient_Id)
FROM patient_appointments
GROUP BY doct_Id; 


2. This query filters all the appointment_status that are scheduled. 
--It is ordered by doct_Id to show the upcoming scheduled appointments for each doctor. 

SELECT patient_Id, doct_Id, reason, appointment_Date,
	mode_of_appointment
FROM patient_appointments
WHERE appointment_status = 'Scheduled'
ORDER BY doct_Id; 


3. What are the percentages of different appointment status. 

SELECT 
appointment_status,
COUNT(*) AS total,
ROUND(COUNT(*) / (SELECT COUNT(*) FROM patient_appointments) * 100,1) AS percentage
FROM patient_appointments
GROUP BY appointment_status;

4. Join function was used to find patient's first name, last name, and contact number who no show their appointment. 

SELECT patient_appointments.appointment_ID AS appointment_ID, 
patient_appointments.patient_Id AS Patient_ID,
patients.FName AS 'First Name', patients.LName AS 'Last Name' 
, patients.contact_No AS 'Contact No.' 
FROM patient_appointments JOIN patients
ON patient_appointments.patient_Id = patients.patient_Id
WHERE appointment_status = 'No-Show';

5. Busiest day of the week with most appointments. 

SELECT 
    DAYNAME(appointment_Date) AS Day,
    COUNT(*) AS total_appointments
FROM patient_appointments
GROUP BY DAYNAME(appointment_Date)
ORDER BY total_appointments DESC;


6. Counts the number of helpers per department. 

SELECT dept_Id, 
COUNT(*) Number_Helpers
FROM helpers 
GROUP BY dept_Id
ORDER BY dept_Id;



